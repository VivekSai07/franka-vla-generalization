# Credentials — never commit
.env

# Local tool state (Ruflo/claude-flow plugin)
.claude-flow/
.claude/*
# ...except the project skills, shared with Copilot: a symlink to .github/skills
!.claude/skills

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Training outputs
outputs/

# Cache directories written by containers (HOME=/vla, so these land here)
.hf_cache/
.torch_cache/
.nv/
.cache/
.local/
.bash_history

# Datasets — push to HF Hub instead, never commit locally
datasets/

# Inference videos — large binaries, not tracked in git
inference/inference_videos/

# Generated script outputs
src/scripts/cam_view_output.png
cam_check.png

# Editor
.vscode/
*.swp

# Linked worktrees — local checkouts, never part of the repo
.worktrees/

# Code graph (.ua/) is committed; only the plugin's scratch is not
.ua/intermediate/
.ua/tmp/
.ua/.trash-*/
.ua/diff-overlay.json

# Existing machine-local offline setup — preserved on disk, not portable source.
/Dockerfile.offline
/Dockerfile.offline.dockerignore
/compose.offline.yml
/docker/offline-constraints.txt
/docker/offline-wheels.sha256
/docs/RTC_LOCAL_WHEELS.md

# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Your HuggingFace username (used in dataset and model repo IDs)
HF_USERNAME=your_hf_username

# HuggingFace access token (needs write permission)
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Weights & Biases API key for training dashboards
# Find at: https://wandb.ai/settings
WANDB_API_KEY=...

# Dataset to push (defaults to franka_libero_stacking_v1 if unset)
# DATASET_DIR=/vla/datasets/franka_libero_stacking_v1

# HuggingFace dataset repo to push to
# Format: <HF_USERNAME>/<repo_name>
HF_REPO_ID=your_hf_username/franka_libero_stacking_v1
